Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Displays:
  - Class: rviz_default_plugins/Grid
    Enabled: true
    Name: Grid
  - Class: rviz_default_plugins/TF
    Enabled: true
    Marker Scale: 0.15
    Name: TF
    Show Arrows: false
    Show Names: false
  - Class: rviz_default_plugins/RobotModel
    Description Source: Topic
    Description Topic:
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Value: /b2w/robot_description
    Enabled: true
    Name: B2-W
    Visual Enabled: true
  - Alpha: 0.5
    Axis: Z
    Class: rviz_default_plugins/PointCloud2
    Color Transformer: AxisColor
    Enabled: true
    Name: XT32
    Size (m): 0.02
    Topic:
      Reliability Policy: Best Effort
      Value: /pointcloud
  - Axis: Z
    Class: rviz_default_plugins/PointCloud2
    Color Transformer: AxisColor
    Enabled: true
    Name: SLAM map
    Size (m): 0.03
    Topic:
      Reliability Policy: Best Effort
      Value: /slam/map_points
  - Alpha: 0.7
    Class: rviz_default_plugins/Map
    Draw Behind: true
    Enabled: true
    Name: Occupancy map
    Topic:
      Durability Policy: Transient Local
      Value: /map
  - Class: rviz_default_plugins/Path
    Enabled: true
    Name: Global plan
    Topic:
      Value: /plan
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Marker Topic:
      Durability Policy: Transient Local
      Reliability Policy: Reliable
      Value: /g1_g5/route_markers
    Name: G1-G5 progression
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Angle: 0.0
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 42.2995730952694
      Target Frame: base_link
      X: 0.0
      Y: 0.0
