+    // Opt-in Stage4 observation diagnostics only; no factor/noise/state changes.
+    void stage4Update(const char* phase, double correctionTime)
+    {
+        const char* enabled = std::getenv("B2W_STAGE4_LIO_DIAGNOSTICS");
+        if (!enabled || std::string(enabled) != "1") {
+            optimizer.update(graphFactors, graphValues);
+            return;
+        }
+        std::cerr << std::setprecision(17)
+                  << "STAGE4_LIO phase=" << phase << " key=" << key
+                  << " correction=" << correctionTime
+                  << " imu_queue=" << imuQueOpt.size()
+                  << " queue_first=" << (imuQueOpt.empty() ? -1. : stamp2Sec(imuQueOpt.front().header.stamp))
+                  << " queue_last=" << (imuQueOpt.empty() ? -1. : stamp2Sec(imuQueOpt.back().header.stamp))
+                  << " last_imu_opt=" << lastImuT_opt
+                  << " integrated_dt=" << imuIntegratorOpt_->deltaTij()
+                  << " factors=" << graphFactors.size() << " values=" << graphValues.size()
+                  << std::endl;
+        try { optimizer.update(graphFactors, graphValues); }
+        catch (const std::exception& error) {
+            std::cerr << "STAGE4_LIO update_failed phase=" << phase
+                      << " what=" << error.what() << std::endl;
+            throw; // Preserve the failure; never manufacture an accepted estimate.
+        }
     }
 
